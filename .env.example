# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION: Official Supabase PostgreSQL, Auth, Storage & Realtime
# Configure your Supabase Project URL and Publishable / Anon Key below:
NEXT_PUBLIC_SUPABASE_URL="https://ehxpegiusizkbmzdtcir.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_Fkq9LJe_7-ufJaDU0pKiIQ_a7WrJAWi"

# SUPABASE_SERVICE_ROLE_KEY (Server-only secret, NEVER prefix with NEXT_PUBLIC_):
# Required for server-side synchronization across RLS-protected tables when using custom portal authentication.
# WARNING: SUPABASE_SERVICE_ROLE_KEY bypasses PostgreSQL RLS. All authorization, ownership, and input checks
# are enforced server-side in /app/api/portal/* and inside least-privilege PostgreSQL RPC functions.
SUPABASE_SERVICE_ROLE_KEY=""

# PORTAL_BACKEND_MODE: Controls authoritative persistence mode ('local_json' | 'dual_write_Read_local' | 'supabase_authoritative').
# Defaults to 'local_json' so local builds and tests never mutate remote databases unless explicitly configured.
PORTAL_BACKEND_MODE="local_json"

# SESSION & CSRF SECURITY KEYS (Server-only secrets, 64-char hex / 32 bytes recommended):
# Supports zero-downtime secret rotation via primary + previous key verification.
PORTAL_SESSION_SECRET_CURRENT=""
PORTAL_SESSION_SECRET_PREVIOUS=""

# TRUSTED_PROXY_COUNT: Number of reverse-proxy hops trusted when parsing X-Forwarded-For for rate limiting.
TRUSTED_PROXY_COUNT="1"

# CANONICAL BACKUP ENCRYPTION & SIGNING KEYS (Server-only secrets, 64-char hex / 32 bytes each):
# Must be backed up in an external secret manager / offline vault independently of the hosting provider.
PORTAL_BACKUP_ENCRYPTION_KEY=""
PORTAL_BACKUP_SIGNING_KEY=""

# OPTIONAL MALWARE SCAN WEBHOOK URL (Server-only):
MALWARE_SCAN_API_URL=""

